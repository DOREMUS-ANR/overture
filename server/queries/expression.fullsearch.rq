PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX efrbroo: <http://erlangen-crm.org/efrbroo/>
PREFIX mus: <http://data.doremus.org/ontology#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX ecrm: <http://erlangen-crm.org/current/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>

SELECT DISTINCT
  ?expression
  ?title
  (?cat AS ?catalogue)
  ?full
  ?composer
WHERE {
  OPTIONAL {
   ?expCreation efrbroo:R17_created ?expression ;
               ecrm:P9_consists_of / ecrm:P14_carried_out_by / foaf:name ?composer .
  }
  OPTIONAL { ?expression mus:U16_has_catalogue_statement / rdfs:label ?cat }
  {
    SELECT DISTINCT ?expression ?title ?full
    WHERE {
      ?expression mus:U70_has_title ?title .
      OPTIONAL { ?expression mus:U16_has_catalogue_statement / rdfs:label ?cat }
      OPTIONAL { ?expression skos:prefLabel | ecrm:P1_is_identified_by ?key }
      OPTIONAL { ?expCreation efrbroo:R17_created ?expression ;
                    ecrm:P9_consists_of / ecrm:P14_carried_out_by / foaf:name ?composer . }

      BIND(CONCAT(coalesce(?composer,""), " " , ?title, " ", coalesce(?key,""), " ", coalesce(?cat,"")) AS ?full) .
      FILTER regex(?full,"%%input%%", "i")
    }
  }
}
